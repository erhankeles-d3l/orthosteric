[importlinter]
root_package = orthosteric
include_external_packages = True

[importlinter:contract:layers]
name = Contract 4 - layer dependency direction (SI17)
type = layers
layers =
    orthosteric.generation
    orthosteric.policy
    orthosteric.eval
    orthosteric.interpretation
    orthosteric.discovery
    orthosteric.learning
    orthosteric.features
    orthosteric.pocket
    orthosteric.quality
    orthosteric.data
    orthosteric.runtime
exhaustive = false

[importlinter:contract:notebooks]
name = Contract 2 - src never imports notebooks or scratch
type = forbidden
source_modules =
    orthosteric
forbidden_modules =
    notebooks
    scratch

[importlinter:contract:tier2]
name = Contract 3 - no training path reaches Tier 2 (inert until data.tier2_gate or learning.tier2_gate exists)
type = forbidden
source_modules =
    orthosteric.learning
forbidden_modules =
    orthosteric.data.tier2_gate
unmatched_ignore_imports_alerting = none

[importlinter:contract:sealed_labels]
name = Contract 5 - no discovery-phase path reaches sealed retrospective labels (Rev. 5 SS0.6.3)
type = forbidden
source_modules =
    orthosteric.discovery
forbidden_modules =
    orthosteric.data.sealed_labels
unmatched_ignore_imports_alerting = none
